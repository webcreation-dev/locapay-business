# WhatsApp Web (réception et archivage uniquement)
WHATSAPP_ENABLED=true
WWEBJS_AUTH_PATH=.wwebjs_auth
# Laissez false pour créer les biens manuellement depuis le tableau de bord.
AUTO_PROPERTY_WORKFLOW=false
# Conservez false pour garder les pièces jointes archivées après traitement.
MEDIA_RETENTION_PURGE=false

# PostgreSQL - ne copiez jamais de mot de passe réel dans ce fichier.
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=whatsapp_logs
DATABASE_URL=postgresql://postgres:change-this-password@db:5432/whatsapp_logs

# Domaine autorisé uniquement si le tableau de bord est servi depuis un autre domaine.
# CORS_ORIGIN=https://dashboard.example.com

# Secret partagé avec NestJS et le worker PM2 fb-media-enricher.
# Ne jamais utiliser cette valeur exemple en production.
FACEBOOK_MEDIA_ENRICHMENT_TOKEN=

# Le bot contacte NestJS pour télécharger les photos et mettre à jour la galerie.
NESTJS_FACEBOOK_URL=http://nestjs_app:8000/properties/create-from-facebook
